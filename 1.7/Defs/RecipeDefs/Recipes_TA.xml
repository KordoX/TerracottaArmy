<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<RecipeDef ParentName="MakeStoneBlocksBase">
		<defName>TA_Make_StoneBlocksRitual</defName>
		<label>make ritual blocks</label>
		<description>Refine Stone blocks into usable ritual blocks.</description>
		<workAmount>2500</workAmount>
		<workSkill>Artistic</workSkill>
		<skillRequirements>
			<Artistic>4</Artistic>
		</skillRequirements>
		<recipeUsers>
			<li>TableSculpting</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>StoneBlocks</li>
					</categories>
				</filter>
				<count>20</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>StoneBlocks</li>
			</categories>
			<disallowedThingDefs>
				<li>TA_BlocksRitual</li>
			</disallowedThingDefs>
		</fixedIngredientFilter>
		<products>
			<TA_BlocksRitual>20</TA_BlocksRitual>
		</products>
	</RecipeDef>

	<RecipeDef>
		<defName>TA_Make_RitualWood</defName>
		<label>make ritual wood</label>
		<description>Make a batch of ritual wood by refining regular wood.</description>
		<jobString>Refining ritual wood.</jobString>
		<workAmount>1500</workAmount>
		<workSkill>Artistic</workSkill>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<allowMixingIngredients>true</allowMixingIngredients>
		<recipeUsers>
			<li>TableSculpting</li>
		</recipeUsers>
		<skillRequirements>
			<Artistic>4</Artistic>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>WoodLog</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>Woody</li>
			</categories>
			<disallowedThingDefs>
				<li>TA_RitualWoodLog</li>
			</disallowedThingDefs>
		</fixedIngredientFilter>
		<products>
			<TA_RitualWoodLog>20</TA_RitualWoodLog>
		</products>
	</RecipeDef>

	<RecipeDef>
		<defName>TA_Make_RitualCore</defName>
		<label>make ritual core</label>
		<description>Make a ritual core out of ritual wood and ancestor soul.</description>
		<jobString>Bounding a Soul to ritual core.</jobString>
		<workAmount>2500</workAmount>
		<workSkill>Artistic</workSkill>
		<workSpeedStat>ReadingSpeed</workSpeedStat>
		<recipeUsers>
			<li>TableSculpting</li>
		</recipeUsers>
		<skillRequirements>
			<Artistic>4</Artistic>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>TA_RitualWoodLog</li>
					</thingDefs>
				</filter>
				<count>100</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>TA_RitualWoodLog</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<TA_RitualCore>1</TA_RitualCore>
		</products>
	</RecipeDef>

	<RecipeDef>
		<defName>TA_Make_TerracottaSoldierClay</defName>
		<label>Burn Terracotta Soldier Clay</label>
		<description>Use ritual material for a new Soldier.</description>
		<jobString>Burning Terracotta Soldier Clay</jobString>
		<workAmount>3000</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workerClass>TerracottaArmy.Recipe_SpawnSpecificPawn</workerClass>
		<recipeUsers>
			<li>TableSculpting</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>TA_RitualWoodLog</li>
					</thingDefs>
				</filter>
				<count>100</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>TA_BlocksRitual</li>
					</thingDefs>
				</filter>
				<count>100</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>TA_RitualCore</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<products>
			<WoodLog>1</WoodLog>
		</products>
		<modExtensions>
			<li Class="TerracottaArmy.PawnSpawnerModExtension">
				<pawnKindToSpawn>TerracottaSoldierClay_Player</pawnKindToSpawn>
			</li>
		</modExtensions>
	</RecipeDef>
</Defs>